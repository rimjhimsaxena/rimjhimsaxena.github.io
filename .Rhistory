rm(list = ls())
# Creating the dataframe
data <- data.frame(
Semester = factor(c("Fall 2019", "Spring 2020", "Spring 2021", "Fall 2021", "Spring 2022", "Summer 2022", "Spring 2023", "Fall 2023"),
levels = c("Fall 2019", "Spring 2020", "Spring 2021", "Fall 2021", "Spring 2022", "Summer 2022", "Spring 2023", "Fall 2023")),
Value = c(4.62, 4.41, 4.86, 4.62, 5.18, 5.1, 4.94, 5.27)
)
# Plotting the trend
library(ggplot2)
ggplot(data, aes(x = Semester, y = Value)) +
geom_line(group=1, colour="blue",linewidth = 1) +
geom_point() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
ylim(1,6) +
labs(title = "Teaching Evaluation", x = "Semester", y = "FCQ")+
theme_minimal()
p1 = ggplot(data, aes(x = Semester, y = Value)) +
geom_line(group=1, colour="blue") +
geom_point() +
geom_text(aes(label = Value), vjust = -1, color = "red") +  # Adjusting the vertical position to avoid overlap
theme(axis.text.x = element_text(angle = 45, hjust = 1),
plot.caption = element_text(hjust = 0, color = "blue")) +
ylim(1,6) +
labs(title = "TA Teaching Evaluation", x = "Semester", y = "FCQ",
caption = "Note*: These values represent the overall rating given to the instructor in Faculty Course Questionnaire. Students enrolled in the course respond to the \nquestionnaire at the end of the semester.The rating is from 1-6. This question was not asked in Fall 2020.")+
theme_minimal()
ggsave("~/OneDrive - UCB-O365/JOB MARKET/teaching/TA_evaluation.pdf", plot = p1, device = "pdf", width = 8, height = 6, units = "in")  # Width and height in inches
